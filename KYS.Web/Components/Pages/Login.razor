@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Giriş Yap · KYS</PageTitle>

<main class="login-page">
    <section class="login-card" aria-labelledby="login-title">
        <div class="login-logo-wrap">
            <div class="login-logo" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 3 27 7v9c0 6-5 10-11 13C10 26 5 22 5 16V7z" />
                    <path d="m10 16 4 4 8-9" />
                </svg>
            </div>
            <span class="brand-label">KYS</span>
            <h1 id="login-title">Kalite Yönetim Sistemi</h1>
            <p>Hesabınıza giriş yapın</p>
        </div>

        <form action="auth/login" method="post" class="login-form" data-login-form>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <div class="field">
                <label for="username">Kullanıcı adı</label>
                <div class="input-group-custom">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                        </svg>
                    </span>
                    <input id="username" name="UserName" type="text" class="login-input" required
                           maxlength="256" autocomplete="username" placeholder="Kullanıcı adınız"
                           autocapitalize="none" spellcheck="false" />
                </div>
            </div>

            <div class="field">
                <label for="password">Şifre</label>
                <div class="input-group-custom">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                    </span>
                    <input id="password" name="Password" type="password"
                           class="login-input login-input-password" required maxlength="1024"
                           autocomplete="current-password" placeholder="Şifreniz" />
                    <button type="button" class="password-toggle" data-password-toggle
                            aria-label="Şifreyi göster" aria-pressed="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="3" />
                            <path class="eye-slash" d="m3 3 18 18" />
                        </svg>
                    </button>
                </div>
            </div>

            <label class="remember-me">
                <input name="RememberMe" type="checkbox" value="true" />
                <span>Beni hatırla</span>
            </label>

            @if (ErrorMessage is not null)
            {
                <div class="error-message" role="alert">@ErrorMessage</div>
            }

            <button type="submit" class="login-button">
                <span class="button-label">Giriş Yap</span>
                <span class="spinner" aria-hidden="true"></span>
                <svg class="button-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
            </button>
        </form>
        <p class="login-help">Hesabınız için sistem yöneticinizle iletişime geçin.</p>
    </section>
    <p class="login-footer">KYS · Kaliteyi birlikte yönetelim.</p>
</main>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "invalid" => "Kullanıcı adı veya şifre hatalı ya da hesabınız aktif değil.",
        "required" => "Lütfen kullanıcı adınızı ve şifrenizi giriniz.",
        "connection" => "Giriş servisine ulaşılamadı. Lütfen bir süre sonra tekrar deneyiniz.",
        "rate" => "Çok fazla giriş denemesi yaptınız. Bir dakika sonra tekrar deneyiniz.",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(KYS.Web.Services.LoginEndpoints.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }

}
